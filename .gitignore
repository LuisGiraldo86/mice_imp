# Vendored upstream checkout -- 120M, and it is pinned in requirements.txt
# instead (mederrata/bayesianquilts @ 7a29ec5). Do not commit it here.
bayesianquilts/

__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Run artefacts. Posterior draws are ~8MB per arm and are rewritten wholesale
# on every re-run, so they would grow the repo by a quarter of a gigabyte per
# grid. The CSV exports and grid_summary.csv are the reproducible outputs and
# stay tracked; regenerate the draws with mice_imp/run_grid.py.
results/**/*.npz
results/**/imputation_model/
results_reduced_anchor/**/*.npz
results_reduced_anchor/**/imputation_model/
results_alt_anchor/**/*.npz
results_alt_anchor/**/imputation_model/
results_cd/**/*.npz
results_cd/**/imputation_model/
# Fits here run inside cm_cd_*.ipynb, whose saved output is the record; the
# .log files are nbconvert status lines and one stopped CLI run.
results_cd/**/*.log

# Smoke runs, the sampler sweep, the superseded 26-item grid, launch logs.
# Kept on disk as provenance, deliberately not in git.
diagnostics/

# Per-respondent estimates (one row per id_work) and private correspondence.
# Removed from the whole history on 2026-11-10; kept on disk only.
theta.csv
mail_chain.txt
